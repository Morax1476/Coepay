# COE-Pay Environment Configuration Template
# Copy this file to .env and configure your production credentials.

# Database Configuration (MySQL / MariaDB)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=coepay_db
DB_USER=coepay_app
DB_PASS=your_secure_password_here

# Allowed CORS Origin for API requests
COEPAY_ALLOWED_ORIGIN=http://localhost:8080

# Supabase Auth Configuration
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-publishable-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_OTP_EXPIRY_SECONDS=300
